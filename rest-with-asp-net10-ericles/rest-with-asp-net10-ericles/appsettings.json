{
  "MSSQLSERVERSQLConnection": {
    "MSSQLSERVERSQLConnectionString": "Data Source=localhost,1433;Initial Catalog=asp_net_10_ericles;User Id=sa;Password=@Admin123;TrustServerCertificate=true;"
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Email": {
    "Subject": "Default Subject",
    "Message": "This is the default message from the API",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "${EMAIL_USERNAME}",
    "Password": "${EMAIL_PASSWORD}",
    "Properties": {
      "SmtpAuth": "true",
      "StarTtlsEnable": "true",
      "StarTtlsRequired": "true"
    },
    "Ssl": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "RestWithAspNet10Ericles": "Debug"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Properties": {
      "Application": "rest-with-asp-net10-ericles"
    }
  },
  "AllowedHosts": "*"
}
